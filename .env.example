# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------------
# Absolute origin for canonical / Open Graph URLs, robots.txt and the sitemap.
# Defaults to https://3264.ai when unset.
# NEXT_PUBLIC_SITE_URL=https://3264.ai

# --- Supabase (not provisioned yet) ---------------------------------------
# No Supabase project exists for this app. When one is created, set these and
# install `@supabase/supabase-js` + `@supabase/ssr`.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to the browser
