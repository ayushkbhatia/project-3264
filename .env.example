# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------------
# Absolute origin for canonical / Open Graph URLs, robots.txt and the sitemap.
# Defaults to https://3264.ai when unset.
# NEXT_PUBLIC_SITE_URL=https://3264.ai

# --- Contact form (src/app/api/contact/deliver.ts) ---------------------------
# Where /contact enquiries go. Set either or both; with neither, production
# answers every enquiry with "That didn't send" (development only logs it).
# A JSON POST per enquiry: a Slack incoming webhook (uses the `text` field),
# or Zapier / Make / n8n / a CRM inbound webhook (name, email, message,
# receivedAt and source are top-level fields).
# CONTACT_WEBHOOK_URL=
# Or email through Resend. CONTACT_FROM must be on a domain verified in Resend;
# until then the default onboarding@resend.dev only reaches the Resend
# account's own address. Reply-To is the sender.
# RESEND_API_KEY=
# CONTACT_TO=            # comma-separated
# CONTACT_FROM=          # e.g. 3264.ai <enquiries@3264.ai>

# --- Supabase (not provisioned yet) ---------------------------------------
# No Supabase project exists for this app. When one is created, set these and
# install `@supabase/supabase-js` + `@supabase/ssr`.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to the browser
